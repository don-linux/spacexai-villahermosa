# Copia este archivo a .env.local y completa lo que necesites. Las dos son opcionales.

# Link que codifica el QR de /creditos. Sin él, "Canjear créditos" muestra un aviso de que no hay evento en curso.
CREDITS_CLAIM_URL=

# Link del evento en Luma. Sin él, no se muestra el logo de Luma en /creditos.
LUMA_EVENT_URL=
